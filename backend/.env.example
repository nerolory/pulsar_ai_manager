APP_HOST=127.0.0.1
APP_PORT=8000
LOG_ENABLED=true
MOCK_MODE=false
ELECTRON_MODE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:15173,http://localhost:18081

# Провайдеры (опционально — можно настроить через POST /api/v1/settings/provider)
# VSELLM_API_KEY=your-key-here
# OPENROUTER_API_KEY=your-key-here

# Local LLM (встроенный llama.cpp, без Ollama)
# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_N_GPU_LAYERS=-1
# HF_TOKEN=optional-for-gated-hf-models
